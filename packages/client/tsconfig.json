{
    "extends": "../../tsconfig.json",
    "compilerOptions": {
        "composite": true,
        "outDir": "./dist",
        "rootDir": "./src",
        "noEmit": false,
        "noUnusedLocals": false,
        "exactOptionalPropertyTypes": false,
        "baseUrl": ".",
        "paths": {
            "@snapshot/snap": [
                "../snap/src/index.ts"
            ]
        },
        "jsx": "react-jsx",
        "lib": [
            "ES2022",
            "DOM",
            "DOM.Iterable"
        ]
    },
    "include": [
        "src/**/*"
    ],
    "exclude": [
        "node_modules",
        "dist"
    ],
    "references": [
        {
            "path": "../shared"
        },
        {
            "path": "../snap"
        }
    ]
}
